<Page
    x:Class="Battery_Health_Viewer.Views.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Battery_Health_Viewer.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Battery Specifications"
                FontSize="28"
                VerticalAlignment="Center"/>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE895;"/>
            </Button>
        </Grid>

        <!-- TABLE -->
        <Border
            Grid.Row="2"
            Padding="16"
            CornerRadius="12"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <ListView ItemsSource="{x:Bind BatteryInfo}">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BatteryProperty">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{x:Bind Description}"
                                Grid.Column="0"
                                Padding="10,8"
                                Opacity="0.75"/>

                            <TextBlock
                                Text="{x:Bind Value}"
                                Grid.Column="1"
                                Padding="10,8"
                                HorizontalAlignment="Right"
                                TextAlignment="Right"/>

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Height="1"
                                Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                Opacity="0.35"/>
                        </Grid>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Border>

    </Grid>
</Page>