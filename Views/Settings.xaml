<Page
    x:Class="Battery_Health_Viewer.Views.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>

        <StackPanel Padding="24" Spacing="24">

            <!-- Title -->
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>

            <!-- Appearance -->
            <StackPanel Spacing="10">

                <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold"/>
                <Border CornerRadius="{ThemeResource ControlCornerRadius}" Padding="15"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderThickness="1">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="App theme" TextWrapping="WrapWholeWords" FontWeight="Normal"/>
                            <TextBlock Text="Override system appearance." Opacity="0.6" TextWrapping="WrapWholeWords" FontSize="12"/> <!-- I DIDN'T KNOW THAT DESCRIPTIONS USE OPACITY! -->
                        </StackPanel>

                        <ComboBox Grid.Column="2" Width="200" HorizontalAlignment="Right" x:Name="ThemeCombo">
                            <ComboBoxItem Content="Use system setting"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- General -->
            <StackPanel Spacing="10">
                <!-- Auto-refresh Speed -->
                <TextBlock Text="General" FontSize="14" FontWeight="SemiBold"/>
                <Border CornerRadius="{ThemeResource ControlCornerRadius}" Padding="15"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderThickness="1">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xEC4A;" FontSize="20" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Auto-refresh speed" TextWrapping="WrapWholeWords" FontWeight="Normal"/>
                            <TextBlock Text="Adjust the speed for auto-refresh. Higher settings use more energy." Opacity="0.6" TextWrapping="WrapWholeWords" FontSize="12"/>
                        </StackPanel>

                        <ComboBox Grid.Column="2" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="RefreshCombo">
                            <ComboBoxItem Content="Low (5s)"/>
                            <ComboBoxItem Content="Normal (2s)"/>
                            <ComboBoxItem Content="High (1s)"/>
                        </ComboBox>

                    </Grid>

                </Border>

                <!-- Capacity Format -->
                <Border CornerRadius="{ThemeResource ControlCornerRadius}" Padding="15"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderThickness="1">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE9D2;" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Display capacity in mAh" TextWrapping="WrapWholeWords" FontWeight="Normal"/>
                            <TextBlock Text="Switch between mWh and mAh display format." Opacity="0.6" TextWrapping="WrapWholeWords" FontSize="12"/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2" x:Name="CapacityToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,-80,0" OnContent="On" OffContent="Off"/>
                        <!-- Kill me because of this AWFUL fix for the Margin-->
                    </Grid>
                </Border>
                <!-- Censor Serial Number -->
                <Border CornerRadius="{ThemeResource ControlCornerRadius}" Padding="15"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderThickness="1">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8AC;" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Censor serial number" TextWrapping="WrapWholeWords" FontWeight="Normal"/>
                            <TextBlock Text="Censor the serial number with asterisks. Useful if you want to screenshot the dashboard." Opacity="0.6" TextWrapping="WrapWholeWords" FontSize="12"/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2" x:Name="CensorToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,-80,0" OnContent="On" OffContent="Off"/>
                    </Grid>
                </Border>
                
                <Border CornerRadius="{ThemeResource ControlCornerRadius}" Padding="15"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderThickness="1">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE72C;" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Reset values to defaults" TextWrapping="WrapWholeWords" FontWeight="Normal"/>
                        </StackPanel>

                        <Button x:Name="ResetButton" Content="Reset" Click="ResetButton_Click"
                            Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- About -->
            <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Spacing="2" Padding="0,8">
                        <TextBlock Text="About Battery Health Viewer" FontSize="14" FontWeight="Normal"/>
                        <TextBlock Text="v1.1.0.0" FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </Expander.Header>

                <Border Padding="20,8,8,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="© 2026, Zakariae Ouddacht." Opacity="0.6" HorizontalAlignment="Left"/>
                        <HyperlinkButton Content="GitHub source code"
                            NavigateUri="https://github.com/ZakariaeOuddacht/battery-health-viewer" HorizontalAlignment="Left"/>
                        <HyperlinkButton Content="Report a bug/issue"
                            NavigateUri="https://github.com/ZakariaeOuddacht/battery-health-viewer/issues/new" HorizontalAlignment="Left"/>
                    </StackPanel>

                </Border>

            </Expander>

        </StackPanel>

    </ScrollViewer>

</Page>