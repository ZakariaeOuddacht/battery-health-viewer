<Page
    x:Class="Battery_Health_Viewer.Views.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>

        <StackPanel Padding="24" Spacing="24">

            <!-- TITLE -->
            <TextBlock
                Text="Settings"
                FontSize="28"
                FontWeight="SemiBold"/>

            <!-- ================= APPEARANCE ================= -->
            <StackPanel Spacing="10">

                <TextBlock Text="Appearance"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <Border
                    CornerRadius="5"
                    Padding="15"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderThickness="1">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE790;"
                                  FontSize="20"
                                  VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="App theme"
                                       FontWeight="Normal"/>

                            <TextBlock Text="Override system appearance."
                                       Opacity="0.6"
                                       FontSize="12"/>
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  Width="200"
                                  HorizontalAlignment="Right"
                                  x:Name="ThemeCombo">
                            <ComboBoxItem Content="Use system setting"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- ================= GENERAL ================= -->
            <StackPanel Spacing="10">

                <TextBlock Text="General"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <Border
                    CornerRadius="5"
                    Padding="15"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderThickness="1">

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xEC4A;"
                                  FontSize="20"
                                  VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Auto-refresh speed"
                                       FontWeight="Normal"/>

                            <TextBlock Text="Adjust the speed for auto-refresh. Higher settings&#x0a;use more energy."
                                       Opacity="0.6"
                                       FontSize="12"/>
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  Width="200"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  x:Name="RefreshCombo">
                            <ComboBoxItem Content="Low (5s)"/>
                            <ComboBoxItem Content="Normal (2s)"/>
                            <ComboBoxItem Content="High (1s)"/>
                        </ComboBox>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- ================= ABOUT ================= -->
            <!-- ================= ABOUT ================= -->
            <Expander Header="About Battery Health Viewer"
              HorizontalAlignment="Stretch"
              IsExpanded="False">

                <StackPanel Spacing="8"
                HorizontalAlignment="Stretch">

                    <TextBlock Text="© 2026, Zakariae Ouddacht&#x0a;Version 1."
                       Opacity="0.7"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"/>

                    <HyperlinkButton
                    Content="GitHub source code"
                    NavigateUri="https://github.com/ZakariaeOuddacht/battery-health-viewer"
                    HorizontalAlignment="Left"/>

                </StackPanel>

            </Expander>

        </StackPanel>

    </ScrollViewer>

</Page>